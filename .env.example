# Copia in .env.local (mai committare). Vedi Appendice B della guida.
DASHBOARD_PASSWORD=       # lunga: una frase di 4 parole vale più di 8 caratteri
AUTH_SECRET=              # openssl rand -hex 32
API_SECRET=               # openssl rand -hex 32  (accesso da script / scorciatoie)
CRON_SECRET=              # openssl rand -hex 32  (Authorization: Bearer ...)
USER_TIMEZONE=Europe/Rome
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Completo:
# SUPABASE_URL=  SUPABASE_SERVICE_KEY=  USER_ID=
# TELEGRAM_BOT_TOKEN=  TELEGRAM_WEBHOOK_SECRET=  TELEGRAM_USER_ID=
# GOOGLE_CALENDAR_ICAL_URL=  FINANCE_FILE_PATH=  (o GOOGLE_SHEETS_FINANCE_ID / GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_SERVICE_ACCOUNT_KEY)
